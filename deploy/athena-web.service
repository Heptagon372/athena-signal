# 아테나 시그널 — 웹 화면(Next.js) systemd 유닛
# 설치 전에 프로덕션 빌드가 필요합니다: cd frontend && npm ci && npm run build
# 설치: sudo cp deploy/athena-web.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now athena-web
# 로그: journalctl -u athena-web -f

[Unit]
Description=Athena Signal Web (Next.js)
After=network-online.target athena-api.service
Wants=network-online.target

[Service]
Type=simple
User=athena
Group=athena
WorkingDirectory=/opt/athena-signal/frontend

Environment=NODE_ENV=production
# Next 의 /autotrade·/static 리라이트가 백엔드를 찾는 주소
Environment=ATHENA_API=http://127.0.0.1:8000

# next start 는 기본적으로 모든 인터페이스에 묶이므로 127.0.0.1 로 제한합니다
ExecStart=/usr/bin/npx next start -p 3000 -H 127.0.0.1

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
